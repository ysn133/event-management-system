# Copy to .env.production at the repository root. Never commit the real file.
COMPOSE_PROJECT_NAME=eventflow-production
PUBLIC_ORIGIN=https://eventflow.example.com
GATEWAY_PORT=43871
DB_NAME=eventflow
DB_USER=eventflow
# Use independent random hexadecimal values (openssl rand -hex 32).
DB_PASSWORD=
JWT_SECRET=
CONTRACT_SERVICE_KEY=
ROOM_BUDGET_SERVICE_KEY=
JWT_ISSUER=eventflow
BOOTSTRAP_USER_EMAIL=
# At least 12 characters; at most 72 UTF-8 bytes. Created only if email is absent.
BOOTSTRAP_USER_PASSWORD=
