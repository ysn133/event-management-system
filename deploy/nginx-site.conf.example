# Add a NEW site to your VPS Nginx; do not replace your other sites.
# Replace domain and port. Enable HTTPS with your usual certificate manager
# BEFORE using login over the public Internet.
server {
    listen 80;
    server_name eventflow.example.com;

    location / {
        proxy_pass http://127.0.0.1:43871;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
