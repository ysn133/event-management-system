# The official NGINX image substitutes FRONTEND_ORIGIN at container startup.
map $http_origin $gateway_cors_origin {
    default "";
    "${FRONTEND_ORIGIN}" $http_origin;
}

server {
    listen 80;
    server_name _;
    server_tokens off;
    charset utf-8;
    client_max_body_size 1m;

    # One CORS policy at the edge, including errors and anonymous preflight.
    add_header Access-Control-Allow-Origin $gateway_cors_origin always;
    add_header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Authorization, Content-Type" always;
    add_header Access-Control-Expose-Headers "Location" always;
    add_header Vary "Origin" always;
    add_header Cache-Control "no-store" always;
    proxy_hide_header Access-Control-Allow-Origin;
    proxy_hide_header Access-Control-Allow-Credentials;
    proxy_hide_header Access-Control-Allow-Methods;
    proxy_hide_header Access-Control-Allow-Headers;
    proxy_hide_header Access-Control-Expose-Headers;
    proxy_hide_header Cache-Control;

    if ($request_method = OPTIONS) { return 204; }

    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Connection "";
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Service credentials belong only on direct, internal service calls.
    proxy_set_header X-Service-Key "";
    proxy_connect_timeout 3s;
    proxy_read_timeout 30s;
    proxy_send_timeout 30s;
    proxy_next_upstream off;

    location = /health {
        default_type application/json;
        return 200 '{"status":"ok","service":"gateway"}';
    }

    # No URI suffix on proxy_pass: preserve the original resource path and query.
    location ~ ^/api/auth(?:/|$) {
        proxy_pass http://host.docker.internal:5005;
    }
    location ~ ^/api/evenements(?:/|$) {
        proxy_pass http://host.docker.internal:5001;
    }
    location ~ ^/api/(?:budgets|depenses)(?:/|$) {
        proxy_pass http://host.docker.internal:5004;
    }
    location ~ ^/api/(?:salles|reservations)(?:/|$) {
        proxy_pass http://host.docker.internal:5242;
    }
    location ~ ^/api/(?:prestataires|contrats-prestataire)(?:/|$) {
        proxy_pass http://host.docker.internal:5002;
    }

    # Resolve the Docker service again after Invités is recreated/reassigned an IP.
    location ^~ /api/v1/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $invites_upstream invites-service:5003;
        proxy_pass http://$invites_upstream$request_uri;
    }

    error_page 502 503 504 =503 @service_unavailable;
    location @service_unavailable {
        default_type application/json;
        return 503 '{"message":"Le service demandé est temporairement indisponible.","error":{"code":"UPSTREAM_UNAVAILABLE","message":"Le service demandé est temporairement indisponible."}}';
    }
    location / {
        default_type application/json;
        return 404 '{"message":"Route API introuvable."}';
    }
}
