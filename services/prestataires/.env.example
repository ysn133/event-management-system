# Export these variables before running node server.js.
DATABASE_URL=postgresql://localhost:5433/eventflow
PGUSER=eventflow
PGPASSWORD=eventflow_dev_password
DB_SSL=false
PORT=5002
AUTH_SERVICE_URL=http://localhost:5005
FRONTEND_ORIGIN=http://localhost:5173
EVENT_SERVICE_URL=http://localhost:5001
BUDGET_SERVICE_URL=http://localhost:5004
# Same private key as Budget; run-local.sh generates it automatically.
CONTRACT_SERVICE_KEY=
