# Copiez ce fichier vers .env puis adaptez les valeurs. Ne commitez JAMAIS .env.

# --- Application ---------------------------------------------------------
# development | test | production
APP_ENV=development
# true = journaux détaillés (aucune trace d'erreur n'est jamais renvoyée au client)
DEBUG=false
# Origines CORS autorisées, séparées par des virgules (vide = aucune)
CORS_ORIGINS=http://localhost:3000

# --- Base de données ---------------------------------------------------------
# Base COMMUNE de l'équipe (dépôt event-management-system : « docker-compose up -d postgres »).
# Hôte, port (5433 par défaut), base, utilisateur et mot de passe : voir database/README.md du dépôt.
DATABASE_URL=postgresql://<utilisateur>:<mot_de_passe>@localhost:5433/eventflow
# Base DÉDIÉE aux tests (docker compose up -d db_test, port 5434). Son nom doit contenir « test » :
# ses tables sont supprimées puis vidées. Ne JAMAIS y mettre la base commune.
TEST_DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5434/invites_test

# --- Service Événements (développé par un autre membre de l'équipe) ------------------
# Le module n'a PAS de table d'événements : il interroge ce service (GET /api/evenements/{id}).
# En local : http://localhost:5001. Dans Docker : voir deploy/compose-invites-service.yaml.
EVENEMENTS_SERVICE_URL=http://localhost:5001
EVENEMENTS_TIMEOUT_SECONDS=5

# --- Authentification / autorisation --------------------------------------
# Production : AUTH_ENABLED=true est OBLIGATOIRE (l'application refuse de démarrer sinon).
# AUTH_ENABLED=true sans fournisseur d'identité branché => toutes les routes répondent 401.
AUTH_ENABLED=false
# Vérifie que l'utilisateur est l'organisateur de l'événement (nécessite AUTH_ENABLED=true).
# À activer lors de l'intégration avec le module d'authentification principal.
ORGANISER_CHECK_ENABLED=false

# --- Envoi des invitations -------------------------------------------------
# none      = aucun fournisseur : l'envoi répond 503 (valeur par défaut)
# simulated = envoi SIMULÉ (aucun e-mail/SMS réel) ; interdit en production
NOTIFICATION_BACKEND=none

# --- Utilisés uniquement par docker-compose.yml (base de test) ---------------
POSTGRES_USER=invites_user
POSTGRES_PASSWORD=change_me
